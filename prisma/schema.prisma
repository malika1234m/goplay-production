generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  email                 String                @unique
  password              String
  phone                 String?
  avatar                String?
  role                  Role                  @default(USER)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  mustChangePassword    Boolean               @default(false)
  isActive              Boolean               @default(true)
  cashCancelCount       Int                   @default(0)
  isBookingSuspended    Boolean               @default(false)
  noShowCount           Int                   @default(0)
  requiresOnlinePayment Boolean               @default(false)
  isSystemAccount       Boolean               @default(false)
  pushToken             String?
  bookings              FacilityBooking[]
  reviews               FacilityReview[]
  facilityWorker        FacilityWorker?
  groundOwnerProfile    GroundOwnerProfile?
  notifications         Notification[]
  openMatchSpots        OpenMatchSpot[]
  passwordResetTokens   PasswordResetToken[]
  providerApplications  ProviderApplication[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroundOwnerProfile {
  id                        String           @id @default(cuid())
  userId                    String           @unique
  businessName              String?
  phone                     String?
  address                   String?
  city                      String?
  bio                       String?
  accountHolderName         String?
  accountNumber             String?
  bankBranch                String?
  bankName                  String?
  commissionRequestedAmount Float?
  commissionRequestedAt     DateTime?
  earnings                  GroundEarning[]
  user                      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts                   Payout[]
  facilities                SportsFacility[]
}

model Payout {
  id                     String             @id @default(cuid())
  ownerId                String
  amount                 Float
  commission             Float              @default(0)
  netAmount              Float
  status                 PayoutStatus       @default(PENDING)
  requestedAt            DateTime           @default(now())
  processedAt            DateTime?
  reference              String?
  notes                  String?
  isCommissionSettlement Boolean            @default(false)
  owner                  GroundOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
}

model SportsCategory {
  id              String           @id @default(cuid())
  name            String           @unique
  icon            String?
  minPlayers      Int              @default(2)
  maxPlayers      Int?
  allowOpenMatch  Boolean          @default(true)
  openMatches     OpenMatch[]
  facilities      SportsFacility[] @relation("SportsCategoryToSportsFacility")
}

model SportsFacility {
  id                 String                 @id @default(cuid())
  name               String
  description        String?
  address            String
  city               String
  hourlyRate         Float
  capacity           Int?
  amenities          String[]
  images             String[]
  status             FacilityStatus         @default(PENDING)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  ownerId            String
  latitude           Float?
  longitude          Float?
  cancelStrikeCount  Int                    @default(0)
  isListingSuspended Boolean                @default(false)
  strikeResetAt      DateTime?
  blockedDates       BlockedDate[]
  availability       FacilityAvailability[]
  bookings           FacilityBooking[]
  courts             FacilityCourt[]
  reviews            FacilityReview[]
  workers            FacilityWorker[]
  earnings           GroundEarning[]
  openMatches        OpenMatch[]
  owner              GroundOwnerProfile     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories         SportsCategory[]       @relation("SportsCategoryToSportsFacility")

  @@index([ownerId])
  @@index([status])
  @@index([city])
  @@index([status, city])
}

model FacilityCourt {
  id           String            @id @default(cuid())
  facilityId   String
  name         String
  description  String?
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  blockedDates BlockedDate[]
  bookings     FacilityBooking[]
  facility     SportsFacility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model FacilityAvailability {
  id         String         @id @default(cuid())
  facilityId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isOpen     Boolean        @default(true)
  facility   SportsFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model BlockedDate {
  id         String         @id @default(cuid())
  facilityId String
  date       DateTime
  reason     String?
  endTime    String?
  startTime  String?
  courtId    String?
  court      FacilityCourt? @relation(fields: [courtId], references: [id], onDelete: Cascade)
  facility   SportsFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, date])
}

model FacilityBooking {
  id                String          @id @default(cuid())
  userId            String
  facilityId        String
  bookingDate       DateTime
  startTime         String
  endTime           String
  totalHours        Float
  totalAmount       Float
  status            BookingStatus   @default(PENDING)
  specialRequests   String?
  contactNumber     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  payHereOrderId    String?         @unique
  paymentMethod     PaymentMethod   @default(ON_ARRIVAL)
  paymentStatus     PaymentStatus   @default(PENDING)
  refundNote        String?
  refundProcessedAt DateTime?
  refundStatus      RefundStatus    @default(NONE)
  archivedAt        DateTime?
  courtId           String?
  cancelledAt       DateTime?
  cancelledBy       String?
  noShowMarkedAt    DateTime?
  refundAmount      Float?
  refundPercent     Int?
  isOpenMatch       Boolean         @default(false)
  openMatchId       String?
  court             FacilityCourt?  @relation(fields: [courtId], references: [id])
  facility          SportsFacility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  openMatch         OpenMatch?      @relation(fields: [openMatchId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  review            FacilityReview?
  earning           GroundEarning?

  @@index([userId])
  @@index([facilityId])
  @@index([status])
  @@index([bookingDate])
  @@index([userId, status])
  @@index([facilityId, bookingDate])
}

model FacilityReview {
  id           String               @id @default(cuid())
  userId       String
  facilityId   String
  bookingId    String               @unique
  rating       Int
  reviewText   String?
  createdAt    DateTime             @default(now())
  reportReason String?
  reported     Boolean              @default(false)
  booking      FacilityBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  facility     SportsFacility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply        FacilityReviewReply?

  @@index([facilityId])
  @@index([userId])
}

model FacilityReviewReply {
  id        String         @id @default(cuid())
  reviewId  String         @unique
  reply     String
  repliedAt DateTime       @default(now())
  review    FacilityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ProviderApplication {
  id                  String            @id @default(cuid())
  userId              String
  status              ApplicationStatus @default(PENDING)
  phone               String
  address             String
  city                String
  facilityName        String
  facilityAddress     String
  facilityCity        String
  proposedHourlyRate  Float
  capacity            Int?
  amenities           String[]
  facilityDescription String?
  adminNotes          String?
  rejectionReason     String?
  reviewedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  categoryIds         String[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
}

model GroundEarning {
  id                  String             @id @default(cuid())
  bookingId           String             @unique
  facilityId          String
  ownerId             String
  grossAmount         Float
  platformFee         Float
  netAmount           Float
  paymentMethod       PaymentMethod
  cashConfirmed       Boolean            @default(false)
  earnedAt            DateTime           @default(now())
  commissionNote      String?
  commissionPaid      Boolean            @default(false)
  commissionSettledAt DateTime?
  booking             FacilityBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  facility            SportsFacility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  owner               GroundOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([facilityId])
  @@index([earnedAt])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  link      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacilityWorker {
  id         String         @id @default(cuid())
  facilityId String
  userId     String         @unique
  addedBy    String
  createdAt  DateTime       @default(now())
  facility   SportsFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

model OpenMatch {
  id                 String            @id @default(cuid())
  lobbyCode          String?           @unique
  facilityId         String
  categoryId         String
  preferredDate      DateTime
  preferredStartTime String
  preferredEndTime   String
  totalSpotsNeeded   Int
  spotsReserved      Int               @default(0)
  status             OpenMatchStatus   @default(COLLECTING)
  matchBookingId     String?
  serviceFeePct      Float             @default(18)
  matchedAt          DateTime?
  expiresAt          DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  booking            FacilityBooking[]
  category           SportsCategory    @relation(fields: [categoryId], references: [id])
  facility           SportsFacility    @relation(fields: [facilityId], references: [id])
  spots              OpenMatchSpot[]

  @@index([facilityId, status])
  @@index([status, preferredDate])
  @@index([facilityId, categoryId, status])
}

model OpenMatchSpot {
  id             String        @id @default(cuid())
  matchId        String
  userId         String
  groupSize      Int           @default(1)
  status         SpotStatus    @default(RESERVED)
  paymentStatus  PaymentStatus @default(PENDING)
  amountPaid     Float
  payHereOrderId String?       @unique
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  match          OpenMatch     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([userId])
  @@index([matchId, status])
}

enum Role {
  USER
  GROUND_OWNER
  ADMIN
  GROUND_WORKER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  ONLINE
  ON_ARRIVAL
}

enum RefundStatus {
  NONE
  NEEDED
  PROCESSED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FacilityStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OpenMatchStatus {
  COLLECTING
  MATCHED
  EXPIRED
  CANCELLED
}

enum SpotStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
