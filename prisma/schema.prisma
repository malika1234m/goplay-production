generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  email                 String                @unique
  password              String
  phone                 String?
  avatar                String?
  role                  Role                  @default(USER)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  mustChangePassword    Boolean               @default(false)
  isActive              Boolean               @default(true)
  cashCancelCount       Int                   @default(0)
  isBookingSuspended    Boolean               @default(false)
  noShowCount           Int                   @default(0)
  requiresOnlinePayment Boolean               @default(false)
  isSystemAccount       Boolean               @default(false)
  pushToken             String?
  /// When this person proved they own the email (Google sign-in, password reset, or an email code)
  emailVerifiedAt       DateTime?
  /// Sessions signed before this are rejected — set on password reset and on account recovery
  sessionsValidAfter    DateTime?
  bookings              FacilityBooking[]
  reviews               FacilityReview[]
  facilityWorker        FacilityWorker?
  groundOwnerProfile    GroundOwnerProfile?
  notifications         Notification[]
  openMatchSpots        OpenMatchSpot[]
  paymentComplaints     PaymentComplaint[]
  passwordResetTokens   PasswordResetToken[]
  providerApplications  ProviderApplication[]
  phoneVerifications    PhoneVerification[]
  emailVerifications    EmailVerification[]
  workerInvites         WorkerInvite[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroundOwnerProfile {
  id                        String           @id @default(cuid())
  userId                    String           @unique
  businessName              String?
  phone                     String?
  address                   String?
  city                      String?
  bio                       String?
  accountHolderName         String?
  accountNumber             String?
  bankBranch                String?
  bankName                  String?
  commissionRequestedAmount Decimal? @db.Decimal(12, 2)
  commissionRequestedAt     DateTime?
  earnings                  GroundEarning[]
  user                      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilities                SportsFacility[]
}

model SportsCategory {
  id             String           @id @default(cuid())
  name           String           @unique
  icon           String?
  minPlayers     Int              @default(2)
  maxPlayers     Int?
  allowOpenMatch Boolean          @default(true)
  openMatches    OpenMatch[]
  facilities     SportsFacility[] @relation("SportsCategoryToSportsFacility")
}

model SportsFacility {
  id                   String                 @id @default(cuid())
  name                 String
  description          String?
  address              String
  city                 String
  hourlyRate           Decimal @db.Decimal(12, 2)
  /// GoPlay's commission for this ground, in percent. Null uses the platform default from Settings.
  commissionRate       Decimal? @db.Decimal(5, 2)
  capacity             Int?
  amenities            String[]
  images               String[]
  status               FacilityStatus         @default(PENDING)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  ownerId              String
  latitude             Float?
  longitude            Float?
  cancelStrikeCount    Int                    @default(0)
  isListingSuspended   Boolean                @default(false)
  strikeResetAt        DateTime?
  // How players may pay for this ground. Null = the owner hasn't chosen yet (treated as BOTH).
  paymentOptions       PaymentOptions?
  // Where players send "Pay online" bank transfers. Blank fields fall back to the owner's profile details.
  paymentBankName      String?
  paymentBankBranch    String?
  paymentAccountName   String?
  paymentAccountNumber String?
  paymentInstructions  String?
  blockedDates         BlockedDate[]
  availability         FacilityAvailability[]
  bookings             FacilityBooking[]
  courts               FacilityCourt[]
  reviews              FacilityReview[]
  workers              FacilityWorker[]
  earnings             GroundEarning[]
  openMatches          OpenMatch[]
  lobbyPayouts         LobbyPayout[]
  paymentComplaints    PaymentComplaint[]
  owner                GroundOwnerProfile     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  categories           SportsCategory[]       @relation("SportsCategoryToSportsFacility")

  @@index([ownerId])
  @@index([status])
  @@index([city])
  @@index([status, city])
  workerInvites        WorkerInvite[]
}

model FacilityCourt {
  id           String            @id @default(cuid())
  facilityId   String
  name         String
  description  String?
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  blockedDates BlockedDate[]
  bookings     FacilityBooking[]
  openMatches  OpenMatch[]
  facility     SportsFacility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model FacilityAvailability {
  id         String         @id @default(cuid())
  facilityId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isOpen     Boolean        @default(true)
  facility   SportsFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model BlockedDate {
  id         String         @id @default(cuid())
  facilityId String
  date       DateTime
  reason     String?
  endTime    String?
  startTime  String?
  courtId    String?
  court      FacilityCourt? @relation(fields: [courtId], references: [id], onDelete: Cascade)
  facility   SportsFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, date])
}

model FacilityBooking {
  id                  String             @id @default(cuid())
  userId              String
  facilityId          String
  bookingDate         DateTime
  startTime           String
  endTime             String
  totalHours          Float
  totalAmount         Decimal @db.Decimal(12, 2)
  status              BookingStatus      @default(PENDING)
  specialRequests     String?
  contactNumber       String?
  contactEmail        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  paymentMethod       PaymentMethod      @default(ON_ARRIVAL)
  paymentStatus       PaymentStatus      @default(PENDING)
  refundNote          String?
  refundProcessedAt   DateTime?
  refundStatus        RefundStatus       @default(NONE)
  archivedAt          DateTime?
  courtId             String?
  cancelledAt         DateTime?
  cancelledBy         String?
  noShowMarkedAt      DateTime?
  refundAmount        Decimal? @db.Decimal(12, 2)
  refundPercent       Int?
  isOpenMatch         Boolean            @default(false)
  openMatchId         String?
  receiptUrl          String?
  receiptUploadedAt   DateTime?
  receiptReviewedAt   DateTime?
  receiptReviewedBy   String?
  receiptRejectReason String?
  /// No-show reports are reviewed by GoPlay: who reported it, the player's side, and the verdict
  noShowMarkedBy      String?
  noShowReview        NoShowReview?
  noShowDispute       String?
  noShowDisputedAt    DateTime?
  noShowReviewedAt    DateTime?
  noShowReviewedBy    String?
  noShowReviewNote    String?
  court               FacilityCourt?     @relation(fields: [courtId], references: [id])
  facility            SportsFacility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  openMatch           OpenMatch?         @relation(fields: [openMatchId], references: [id])
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  review              FacilityReview?
  earning             GroundEarning?
  complaints          PaymentComplaint[]

  @@index([userId])
  @@index([facilityId])
  @@index([status])
  @@index([bookingDate])
  @@index([userId, status])
  @@index([facilityId, bookingDate])
  @@index([noShowReview])
}

model FacilityReview {
  id           String               @id @default(cuid())
  userId       String
  facilityId   String
  bookingId    String               @unique
  rating       Int
  reviewText   String?
  createdAt    DateTime             @default(now())
  reportReason String?
  reported     Boolean              @default(false)
  booking      FacilityBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  facility     SportsFacility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply        FacilityReviewReply?

  @@index([facilityId])
  @@index([userId])
}

model FacilityReviewReply {
  id        String         @id @default(cuid())
  reviewId  String         @unique
  reply     String
  repliedAt DateTime       @default(now())
  review    FacilityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ProviderApplication {
  id                  String            @id @default(cuid())
  userId              String
  status              ApplicationStatus @default(PENDING)
  phone               String
  address             String
  city                String
  facilityName        String
  facilityAddress     String
  facilityCity        String
  proposedHourlyRate  Decimal @db.Decimal(12, 2)
  capacity            Int?
  amenities           String[]
  facilityDescription String?
  adminNotes          String?
  rejectionReason     String?
  reviewedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  categoryIds         String[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
}

model GroundEarning {
  id                  String             @id @default(cuid())
  bookingId           String             @unique
  facilityId          String
  ownerId             String
  grossAmount         Decimal @db.Decimal(12, 2)
  platformFee         Decimal @db.Decimal(12, 2)
  netAmount           Decimal @db.Decimal(12, 2)
  paymentMethod       PaymentMethod
  cashConfirmed       Boolean            @default(false)
  earnedAt            DateTime           @default(now())
  commissionNote      String?
  commissionPaid      Boolean            @default(false)
  commissionSettledAt DateTime?
  booking             FacilityBooking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  facility            SportsFacility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  owner               GroundOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([facilityId])
  @@index([earnedAt])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  link      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Raised by a player when an owner rejects their payment receipt.
model PaymentComplaint {
  id         String           @id @default(cuid())
  userId     String
  facilityId String
  bookingId  String?
  spotId     String?
  message    String
  status     ComplaintStatus  @default(OPEN)
  adminNote  String?
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   SportsFacility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  booking    FacilityBooking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  spot       OpenMatchSpot?   @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model FacilityWorker {
  id         String         @id @default(cuid())
  facilityId String
  userId     String         @unique
  addedBy    String
  createdAt  DateTime       @default(now())
  facility   SportsFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

model OpenMatch {
  id                 String            @id @default(cuid())
  lobbyCode          String?           @unique
  facilityId         String
  courtId            String?
  categoryId         String
  preferredDate      DateTime
  preferredStartTime String
  preferredEndTime   String
  totalSpotsNeeded   Int
  spotsReserved      Int               @default(0)
  status             OpenMatchStatus   @default(COLLECTING)
  matchBookingId     String?
  serviceFeePct      Float             @default(18)
  /// Who players transfer to. New lobbies pay GoPlay, which pays the ground once the lobby fills;
  /// lobbies created before that change keep paying the ground directly.
  payee              LobbyPayee        @default(GROUND)
  matchedAt          DateTime?
  expiresAt          DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  booking            FacilityBooking[]
  category           SportsCategory    @relation(fields: [categoryId], references: [id])
  court              FacilityCourt?    @relation(fields: [courtId], references: [id])
  facility           SportsFacility    @relation(fields: [facilityId], references: [id])
  spots              OpenMatchSpot[]
  payout             LobbyPayout?

  @@index([facilityId, status])
  @@index([status, preferredDate])
  @@index([facilityId, categoryId, status])
}

model OpenMatchSpot {
  id                  String             @id @default(cuid())
  matchId             String
  userId              String
  groupSize           Int                @default(1)
  status              SpotStatus         @default(RESERVED)
  paymentStatus       PaymentStatus      @default(PENDING)
  amountPaid          Decimal @db.Decimal(12, 2)
  amountDue           Decimal              @db.Decimal(12, 2) @default(0)
  receiptUrl          String?
  receiptUploadedAt   DateTime?
  receiptReviewedAt   DateTime?
  receiptReviewedBy   String?
  receiptRejectReason String?
  cancelledAt         DateTime?
  /// Refunds GoPlay owes for lobbies it collected (expired, slot lost, or the player left)
  refundStatus        RefundStatus       @default(NONE)
  refundAmount        Decimal? @db.Decimal(12, 2)
  refundBankName      String?
  refundBankBranch    String?
  refundAccountName   String?
  refundAccountNumber String?
  refundDetailsAt     DateTime?
  refundReference     String?
  refundedAt          DateTime?
  refundedBy          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  match               OpenMatch          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaints          PaymentComplaint[]

  @@index([matchId])
  @@index([userId])
  @@index([matchId, status])
}

enum Role {
  USER
  GROUND_OWNER
  ADMIN
  GROUND_WORKER
}

enum NoShowReview {
  PENDING
  CONFIRMED
  OVERTURNED
}

enum BlockReason {
  NO_SHOWS
  FAKE_BOOKINGS
  PAYMENT_FRAUD
  ABUSE
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  ONLINE
  ON_ARRIVAL
}

enum RefundStatus {
  NONE
  NEEDED
  PROCESSED
}

// ONLINE = bank transfer to the ground owner. PENDING means no receipt yet.
enum PaymentStatus {
  PENDING
  RECEIPT_SUBMITTED
  REJECTED
  PAID
  FAILED
  REFUNDED
}

enum PaymentOptions {
  ON_ARRIVAL_ONLY
  ONLINE_ONLY
  BOTH
}

enum ComplaintStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum FacilityStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OpenMatchStatus {
  COLLECTING
  MATCHED
  EXPIRED
  CANCELLED
}

enum SpotStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  REFUNDED
}

/// One SMS code sent to confirm a player's phone before a pay-at-ground booking.
/// A row with verifiedAt set means that user has proven they own that number.
model PhoneVerification {
  id         String    @id @default(cuid())
  userId     String
  phone      String // normalised 07XXXXXXXX
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phone])
  @@index([phone, createdAt])
}

/// One emailed code that confirms a pay-at-ground booking. Unlike the phone check this is
/// per booking: a verified row is spent (usedAt) by the booking it let through.
model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  email      String // lower-cased
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email])
  @@index([email, createdAt])
}

/// Fixed-window rate-limit counter, shared by every server instance (in-memory counters
/// aren't on Vercel, where each request can land on a different instance).
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

enum LobbyPayee {
  GROUND
  PLATFORM
}

enum PayoutStatus {
  DUE
  PAID
  CANCELLED
}

/// What GoPlay owes a ground for a filled lobby it collected the money for. Admin-only figures:
/// the owner is shown the payout amount, never the commission or what GoPlay kept.
model LobbyPayout {
  id               String         @id @default(cuid())
  matchId          String         @unique
  facilityId       String
  collectedAmount  Decimal          @db.Decimal(12, 2) // paid spots at the moment the lobby filled
  courtAmount      Decimal          @db.Decimal(12, 2) // hourly rate × hours
  commissionRate   Decimal          @db.Decimal(6, 4) // fraction, e.g. 0.1
  commissionAmount Decimal @db.Decimal(12, 2)
  amount           Decimal          @db.Decimal(12, 2) // what the ground receives
  status           PayoutStatus   @default(DUE)
  reference        String?
  paidAt           DateTime?
  paidBy           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  match            OpenMatch      @relation(fields: [matchId], references: [id], onDelete: Restrict)
  facility         SportsFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([facilityId])
}

/// An email (and optionally phone) barred from GoPlay. Survives account deletion, so a blocked
/// person can't simply sign up again — by password or Google. Lifted, not deleted, for the record.
model AccountBlock {
  id        String      @id @default(cuid())
  email     String      // lower-cased
  phone     String?     // normalised 07XXXXXXXX
  userId    String?
  reason    BlockReason
  details   String?
  blockedBy String
  createdAt DateTime    @default(now())
  liftedAt  DateTime?
  liftedBy  String?
  liftNote  String?

  @@index([email])
  @@index([phone])
  @@index([userId])
}

/// A ground owner's invitation for an existing player account to become one of its workers.
/// Nothing changes on the player's account until they accept it themselves.
model WorkerInvite {
  id          String             @id @default(cuid())
  facilityId  String
  userId      String
  invitedBy   String
  status      WorkerInviteStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  respondedAt DateTime?
  facility    SportsFacility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([facilityId, status])
}

enum WorkerInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}
